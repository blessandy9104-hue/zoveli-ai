{
  "name": "@zoveli/auth",
  "version": "0.1.1",
  "description": "Passwordless email-OTP auth for Zoveli. Works with any inbox including @proton.me (no OAuth partnership needed)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "oxlint",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@deepseek-ai/dsh-core": "workspace:*",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "tsdown": "^0.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "oxlint": "catalog:",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.17"
  }
}
