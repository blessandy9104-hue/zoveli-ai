{
  "name": "@zoveli/core",
  "version": "0.1.2",
  "description": "Legacy prompt and shared version exports for Zoveli AI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./mathcore-mcp": {
      "types": "./dist/mathcore-mcp.d.ts",
      "import": "./dist/mathcore-mcp.js",
      "require": "./dist/mathcore-mcp.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js",
      "require": "./dist/version.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "oxlint",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@deepseek-ai/dsh-core": "workspace:*",
    "@zoveli/math-intelligence": "workspace:*",
    "@zoveli/memory-store": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "oxlint": "catalog:"
  }
}
