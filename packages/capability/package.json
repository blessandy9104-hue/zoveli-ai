{
  "name": "@zoveli/capability",
  "version": "0.1.1",
  "description": "Zoveli capability awareness: dynamic discovery, introspection, and adaptation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "oxlint",
    "clean": "rm -rf dist",
    "scan": "node ../../scripts/scan-capabilities.js",
    "report": "node ../../scripts/capability-report.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "oxlint": "catalog:"
  }
}
