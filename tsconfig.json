{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": "."
  },
  "exclude": ["node_modules", "dist", "**/dist/**"],
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/math-intelligence" },
    { "path": "./packages/math-domains" },
    { "path": "./packages/memory" },
    { "path": "./packages/memory-store" },
    { "path": "./packages/skills" },
    { "path": "./apps/cli" },
    { "path": "./apps/desktop" },
    { "path": "./packages/languages" },
    { "path": "./packages/capability" },
    { "path": "./packages/search" },
    { "path": "./packages/code-analysis" },
    { "path": "./packages/docgen" },
    { "path": "./packages/health" },
    { "path": "./packages/graph" },
    { "path": "./packages/scheduler" },
    { "path": "./packages/secscan" },
    { "path": "./packages/sysinfo" },
    { "path": "./packages/host" },
    { "path": "./packages/persona" },
    { "path": "./packages/webresearch" },
    { "path": "./packages/auth" },
    { "path": "./packages/config-audit" },
    { "path": "./packages/diagnostics" }
  ]
}