{
  "name": "zoveli",
  "version": "0.1.0",
  "private": true,
  "description": "Zoveli AI - local-first personal assistant with verified math, 25 packages and 58 default tools.",
  "author": "Andy <blessandy9104@gmail.com> (https://github.com/blessandy9104-hue)",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" exec tsc -p tsconfig.json",
    "build:core": "pnpm --filter @zoveli/cli... exec tsc -p tsconfig.json",
    "doctor": "node scripts/doctor.js",
    "prestart": "pnpm run build",
    "start": "node apps/cli/dist/cli.js",
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" exec tsc --noEmit",
    "dev": "pnpm --filter @zoveli/cli run dev",
    "desktop": "pnpm --filter @zoveli/desktop run dev",
    "install:mathcore": "pip install -e ./mathcore",
    "mathcore:mcp": "mathcore-mcp",
    "vault:backup": "pnpm run build:core && node apps/cli/dist/cli.js backup",
    "vault:verify": "pnpm run build:core && node apps/cli/dist/cli.js verify",
    "vault:restore": "pnpm run build:core && node apps/cli/dist/cli.js restore",
    "migrate:vault": "pnpm run build:core && node apps/cli/dist/cli.js migrate",
    "config:check": "pnpm run build:core && node apps/cli/dist/cli.js config-check",
    "health:check": "pnpm run build:core && node apps/cli/dist/cli.js health",
    "release:check": "node scripts/release-check.mjs",
    "plugin:check": "node scripts/plugin-check.mjs",
    "perf:check": "pnpm run build:core && node scripts/perf-check.mjs",
    "package:mathcore": "node scripts/build-mathcore-runtime.mjs",
    "package:runtime": "node scripts/build-runtime.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "acceptance:runtime": "node scripts/product-acceptance.mjs",
    "test": "vitest run",
    "lint": "oxlint packages apps tests scripts --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/node_modules/**\" --ignore-pattern \"**/coverage/**\"",
    "create:plugin": "node scripts/create-plugin.mjs",
    "clean": "node scripts/clean.mjs",
    "capability:scan": "node scripts/scan-capabilities.js",
    "capability:report": "node scripts/capability-report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "oxlint": "^0.18.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@11.7.0"
}
